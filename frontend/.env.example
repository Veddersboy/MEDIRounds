# Copy to .env.local for local dev (npm run dev). In Docker, these come from the root .env instead.
# Plain postgresql:// scheme for the pg driver (not the backend's postgresql+asyncpg://)
DATABASE_URL=postgresql://medirounds_app:pasword123@localhost:5432/medirounds_db
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
